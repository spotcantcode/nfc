# Fixed origin. Keep this domain for the lifetime of written stickers.
NEXT_PUBLIC_APP_URL=http://localhost:3000
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only Supabase secret key (or legacy service_role key).
SUPABASE_SECRET_KEY=
# Comma-separated, case-insensitive exact email addresses.
ADMIN_EMAILS=you@example.com
# At least 32 random bytes: openssl rand -hex 32
SESSION_SECRET=
# Required by Vercel's daily retention job (openssl rand -hex 32).
CRON_SECRET=
